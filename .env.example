# ==========================================
# CodeCord - Variables de Entorno de Ejemplo (Template Sanitizado)
# ==========================================

# Token de autenticación del Bot de Discord (REQUERIDO)
BOT_TOKEN=tu_discord_bot_token_aqui

# ID de la Aplicación / Cliente de Discord (para despliegue de Slash Commands)
CLIENT_ID=tu_discord_client_id_aqui

# Secret de la Aplicación de Discord (para OAuth2 en el Panel Web)
CLIENT_SECRET=tu_discord_client_secret_aqui

# ID del Servidor principal de Discord (para registro rápido de Slash Commands en desarrollo)
GUILD_ID=tu_guild_id_aqui

# Secret para las sesiones Express del Panel Web (Generar string aleatorio seguro de 32+ caracteres)
SESSION_SECRET=tu_session_secret_seguro_aqui

# Puerto para el Panel Web Express (Por defecto: 22550)
PORT=22550

# URL pública del Panel Web (para redirecciones de OAuth2)
PANEL_URL=http://localhost:22550

# OpenAI API Key (Opcional - para módulos de IA si están habilitados)
OPENAI_API_KEY=tu_openai_api_key_aqui
