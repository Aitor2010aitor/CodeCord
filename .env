# Solo el token del bot es necesario para ejecutar el bot
BOT_TOKEN=
CLIENT_ID=
CLIENT_SECRET=
GUILD_ID=
# CLIENT_ID y GUILD_ID se usan solo para deploy de comandos slash
# CLIENT_SECRET se usa solo si activas OAuth del panel web
# Ejemplo para deploy:
# CLIENT_ID=123456789012345678
# GUILD_ID=123456789012345678
# CLIENT_SECRET=tu_secreto_si_usas_el_panel
